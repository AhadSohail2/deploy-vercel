# Public hostname (use nip.io if you have no domain: YOUR_EC2_IP.nip.io)
DOMAIN=your-domain.com
DEPLOY_HOST=your-domain.com
FRONTEND_ORIGIN=http://your-domain.com

NEXT_PUBLIC_API_URL=http://your-domain.com/api
NEXT_PUBLIC_SOCKET_URL=http://your-domain.com

# Local Redis (api-server + build jobs on same EC2)
REDIS_URL=redis://127.0.0.1:6379

# AWS — clone/build/upload runs on this server (no ECS)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=your-s3-bucket

# Service ports
PORT=9000
SOCKET_PORT=9002
S3_REVERSE_PROXY_PORT=8000
