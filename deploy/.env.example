# Public hostname (use nip.io if you have no domain: YOUR_EC2_IP.nip.io)
DOMAIN=your-domain.com
DEPLOY_HOST=your-domain.com
NEXT_PUBLIC_API_URL=http://your-domain.com/api
NEXT_PUBLIC_SOCKET_URL=http://your-domain.com
FRONTEND_ORIGIN=http://your-domain.com
# Comma-separated if you need multiple origins, e.g. http://localhost:3000,http://your-domain.com

# Local Redis on EC2
REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL_FOR_ECS=redis://EC2_PRIVATE_IP:6379

# AWS (fill with your credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
ECS_CLUSTER_ARN=
ECS_TASK_ARN=
ECS_SUBNETS=
ECS_SECURITY_GROUPS=

# Backend API (+ Socket.IO on the same port)
PORT=9000
# SOCKET_PORT is unused — Socket.IO shares PORT 9000

S3_BUCKET=your-s3-bucket

# S3 reverse proxy
S3_REVERSE_PROXY_PORT=8000
